# MapTiler base map key. Get one at https://cloud.maptiler.com (free tier).
# Restrict the key to the deploy origin in the MapTiler dashboard: it ships in
# the client bundle, so origin restriction is the control, not secrecy.
# Leave unset for local development and the map falls back to OpenStreetMap.
VITE_MAPTILER_KEY=

# Optional. Defaults to "ocean" (bathymetry + shipping detail).
# Alternatives: streets-v2, basic-v2, backdrop.
VITE_MAPTILER_STYLE=
